{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Laxman Nepal AI Tool",
  "type":"object",
  "required":["title","slug","url","category","pricing","description","lastVerified","verificationStatus","verificationConfidence","lifecycleStatus","platforms","languages"],
  "properties":{
    "title":{"type":"string","minLength":1},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "url":{"type":"string","format":"uri","pattern":"^https?://"},
    "shortUrl":{"type":"string","format":"uri"},
    "logo":{"type":"string"},
    "category":{"type":"string","minLength":1},
    "pricing":{"type":"string","minLength":1},
    "freeTier":{"type":"string"},
    "description":{"type":"string","minLength":1,"maxLength":500},
    "benefits":{"type":"array","items":{"type":"string"}},
    "limitations":{"type":"array","items":{"type":"string"}},
    "useCases":{"type":"array","items":{"type":"string"}},
    "prompts":{"type":"array","items":{"type":"string"}},
    "source":{"type":"string"},
    "trendingRank":{"type":"integer","minimum":1},
    "lastVerified":{"type":"string","format":"date"},
    "verificationStatus":{"type":"string","enum":["verified","unverified","needs-review"]},
    "verificationConfidence":{"type":"string","enum":["high","medium","low"]},
    "lifecycleStatus":{"type":"string","enum":["active","acquired","deprecated","shutdown","needs-review"]},
    "platforms":{"type":"array","items":{"type":"string"}},
    "languages":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":true
}
